# Configuration locale de l'application.
# Copier ce fichier en .env puis adapter les valeurs. Le fichier .env n'est pas versionné.

# Base de données
DB_HOST=localhost
DB_NAME=gestion_notes
DB_USER=root
DB_PASS=

# Déconnexion après inactivité, en secondes (300 = 5 minutes)
SESSION_TIMEOUT=300

# Assistant IA : fournisseurs essayés dans l'ordre (le suivant sert de secours).
# Changer de fournisseur ou d'ordre ne demande que ce fichier. Un fournisseur non configuré est sauté.
AI_PROVIDERS=gemini,groq,ollama
# Délai maximal d'un appel au fournisseur, en secondes
AI_TIMEOUT=30
# Nouvelles tentatives sur le même fournisseur en cas d'erreur passagère (délai, 429, 5xx)
AI_RETRIES=1
# Nombre maximal de questions par utilisateur et par heure
AI_RATE_LIMIT=30
# Durée pendant laquelle une même question reçoit la réponse en cache, en secondes
AI_CACHE_TTL=600
# Fichier des autorités de certification pour HTTPS (facultatif ; sous Windows, le magasin du système est utilisé)
AI_CA_BUNDLE=

# Google Gemini (service externe, API native) : clé gratuite sur https://aistudio.google.com/apikey
# Modèles disponibles : https://ai.google.dev/gemini-api/docs/models (version « -lite » : moins chère, plus rapide)
# gemini-2.5-flash n'est plus ouvert aux nouveaux comptes (HTTP 404) : utiliser un modèle 3.x
# Offre gratuite : Google peut réutiliser les requêtes, donc données de démonstration uniquement.
GEMINI_FORMAT=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tarif de l'offre payante, en dollars par million de tokens (0 avec l'offre gratuite) :
# à reprendre sur https://ai.google.dev/gemini-api/docs/pricing pour le modèle choisi
GEMINI_PRICE_IN=0
GEMINI_PRICE_OUT=0
# Offre gratuite : quota par modèle (constaté pour gemini-3.8-flash : 5 requêtes/min, 20/jour ;
# une question = 2 à 3 requêtes). Un second modèle Gemini, avec la même clé, sert de secours :
# l'ajouter à AI_PROVIDERS, par exemple AI_PROVIDERS=gemini,gemini_lite,groq,ollama
GEMINI_LITE_FORMAT=gemini
GEMINI_LITE_API_KEY=
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_LITE_PRICE_IN=0
GEMINI_LITE_PRICE_OUT=0

# Groq (service externe) : clé gratuite sur https://console.groq.com/keys
# Modèles disponibles : https://console.groq.com/docs/models (choisir un modèle qui gère les outils)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Tarif de l'offre payante, en dollars par million de tokens (pour estimer le coût ; 0 avec l'offre gratuite)
# (valeurs ci-dessous : anciens tarifs de llama-3.3-70b ; reprendre ceux du modèle choisi sur https://groq.com/pricing)
GROQ_PRICE_IN=0.59
GROQ_PRICE_OUT=0.79

# Ollama (modèle local, aucune donnée ne sort de la machine) : https://ollama.com
# Installer puis : ollama pull qwen2.5:7b  (ou qwen2.5:3b, plus léger : tient dans 4 Go de mémoire vidéo)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:7b
# Délai propre à Ollama : le premier appel charge le modèle dans la carte graphique (20 à 40 s)
OLLAMA_TIMEOUT=90
OLLAMA_PRICE_IN=0
OLLAMA_PRICE_OUT=0
